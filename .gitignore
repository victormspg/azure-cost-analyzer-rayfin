# ---- Dependencies / build ----
node_modules
dist
dist-ssr
*.tsbuildinfo
.vite
coverage

# ---- Logs ----
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- SECRETS / environment-specific (never commit) ----
# Local env values (endpoints, keys, tenant, publishable key)
.env
.env.local
.env.*.local
*.local

# Fabric connection config — fabric.yaml lives at the app root (workspace + semantic model IDs)
fabric.yaml

# Auto-generated by fabric-app-data (embeds workspace/model IDs)
src/fabric.generated.ts
app/src/fabric.generated.ts

# RayFin deployment state
rayfin/.env*
rayfin/.deployments.json
rayfin/.temp/
# RayFin project config — holds the deployed hosting/redirect URL; regenerated from rayfin.yml.example
**/rayfin.yml

# Azure Functions local settings
local.settings.json
**/local.settings.json

# Python virtual envs (e.g. functions/data-agent/.venv for local func start)
**/.venv/
.venv/

# ---- Internal-only docs (working snapshots, not for publish) ----
**/*.internal.md

# ---- OS / IDE ----
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
