# ─────────────────────────────────────────────────────────────────────────────
# ACA app — local environment template.
# Copy to `.env.local` (git-ignored) and fill with values shared out of band.
# All keys are OPTIONAL: with none set, the app runs fully in demo mode.
# ─────────────────────────────────────────────────────────────────────────────

# Feature 2 — Tag-writer Function (Action Center "Tag now" → Azure ARM tags)
# URL of the deployed Fabric/Azure Function that PATCHes resource tags.
VITE_TAG_WRITER_URL=
# Optional function key. Prefer Entra auth (Easy Auth) and leave this blank.
VITE_TAG_WRITER_KEY=

# Feature 4 — Data Agent proxy Function (FinOps Assistant grounded chat)
# URL of the Function that calls the published Fabric Data Agent.
VITE_DATA_AGENT_URL=
# Optional function key. Prefer Entra auth and leave this blank.
VITE_DATA_AGENT_KEY=

# Feature 3 — Role-based access (optional overrides)
# Comma-separated Entra group object IDs → role mapping is configured in the app,
# but you can override the default role during local dev:
#   VITE_FORCE_ROLE=cfo | finops | admin
VITE_FORCE_ROLE=
