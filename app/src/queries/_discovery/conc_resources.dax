EVALUATE
TOPN (
    12,
    SUMMARIZECOLUMNS (
        gold_cost_by_resource[ResourceName],
        gold_cost_by_resource[ResourceType],
        gold_cost_by_resource[ResourceGroupName],
        gold_cost_by_resource[SubAccountName],
        "Cost", [Resource Effective Cost]
    ),
    [Cost], DESC
)
ORDER BY [Cost] DESC
