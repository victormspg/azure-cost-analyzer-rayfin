id: azure-cost-analyzer-app
name: Azure Cost Analyzer
version: 1.0.0
services:
  auth:
    enabled: true
    fabric:
      enabled: true
    allowedRedirectUris:
      - http://localhost:5173
      # `rayfin up` appends your deployed hosting URL here (kept only in the
      # git-ignored rayfin.yml, never committed).
  data:
    enabled: false
  storage:
    enabled: false
  staticHosting:
    enabled: true
    folder: dist
    buildCommand: npm run build:fabric
    indexDocument: index.html
  functions:
    enabled: false
